{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Vendas Response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "clienteId": {
      "type": "string",
      "format": "uuid"
    },
    "veiculoId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": ["INICIADA", "CONCLUIDA", "CANCELADA"]
    },
    "dataVenda": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "clienteId",
    "veiculoId",
    "status"
  ]
}
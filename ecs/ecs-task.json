{
  "family": "carstore-vendas-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::797666780798:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::797666780798:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "carstore-service-vendas",
      "image": "797666780798.dkr.ecr.us-east-1.amazonaws.com/carstore:vendas-latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "COGNITO_CLIENT_ID", "value": "7llcjej1iahhmvdeu5c46raigh" },
        { "name": "COGNITO_REGION", "value": "us-east-1" },
        { "name": "COGNITO_USER_POOL_ID", "value": "us-east-1_RD6ZrZn9R" },

        { "name": "CLIENTE_API_URL", "value": "http://3.237.237.214:8080" },
        { "name": "VEICULO_API_URL", "value": "http://13.222.237.186:8080" },

        { "name": "COGNITO_USER_EMAIL", "value": "systemUser@email.com" },
        { "name": "COGNITO_USER_PASSWORD", "value": "-D0{EgPpbu;L" },
        { "name": "COGNITO_AUTH_URL", "value": "https://cognito-idp.us-east-1.amazonaws.com/AuthenticationResult/AccessToken" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/carstore-vendas",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
